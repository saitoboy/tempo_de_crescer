PORT=3003
TZ=America/Sao_Paulo
# Postgres local. Ajuste usuário, senha e porta para os seus.
# No EasyPanel, o host é o nome do serviço de banco, não localhost.
# Senha com @ : / # ? precisa ser escapada aqui (%40 %3A %2F %23 %3F).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tempo_de_crescer"

# Usuário administrador criado pelo seed na primeira subida.
# Sem ADMIN_EMAIL e ADMIN_SENHA nenhum admin é criado, e o seed avisa.
# O seed nunca sobrescreve a senha de um admin que já existe.
#
# ATENÇÃO: este arquivo é versionado pelo git. Não escreva senha de verdade
# aqui — ela vai para o repositório. Os valores reais ficam no .env, que é
# ignorado, e no painel do EasyPanel.
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME="Guilherme Saito"

# https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# https://console.cloud.google.com — YouTube Data API v3
YOUTUBE_API_KEY=
CHANNEL_HANDLE=@ibps.muriae

# Agendamento da ingestão incremental. Padrão: de 4 em 4 horas.
# A publicação no blog é manual e a janela é larga (o culto de domingo pode
# sair até as 20h da segunda), então insistir sai mais barato que acertar o
# horário. Use "off" em desenvolvimento, para não bater no blog a cada reinício.
CRON_INGESTAO=0 */4 * * *

# Opcional: rede corporativa com proxy.
# Em componentes, não como URL: a senha pode ter "@" ou ":", que quebram a
# forma http://user:pass@host:port. Ver src/utils/proxy.ts.
PROXY_HOST=
PROXY_PORT=3128
PROXY_USER=
PROXY_PASS=

# Token das rotas de escrita (PATCH/POST). Sem ele a escrita fica bloqueada.
# Gere um valor longo e aleatorio. O login por usuario e senha entra na Fase 7.
API_TOKEN=

# Segredo que assina os tokens de sessao. Gere um valor longo e aleatorio.
JWT_SEGREDO=
JWT_HORAS=12

# Chaves para escrever devocional por API, separadas por virgula.
# O limite e POR CHAVE, entao varias chaves viram varias cotas: quando uma
# esgota (429), a proxima assume sozinha. Sem nenhuma, o script cai no CLI do
# Claude e consome a assinatura de quem roda.
# Groq: https://console.groq.com/keys
GROQ_API_KEYS=
GROQ_MODELO=openai/gpt-oss-120b
# NVIDIA NIM: https://build.nvidia.com
NVIDIA_API_KEYS=
NVIDIA_MODELO=

# De onde o front pode chamar a API, separado por virgula.
# Vazio libera qualquer origem -- serve para o Swagger e curl em
# desenvolvimento. EM PRODUCAO ISTO TEM DE SER PREENCHIDO: sem ele, qualquer
# site pode chamar a API com o token do usuario logado.
# Ex.: FRONT_ORIGEM=https://livro.ibps.org.br
FRONT_ORIGEM=

PORT=3003
TZ=America/Sao_Paulo
# Postgres local. Ajuste usuário, senha e porta para os seus.
# No EasyPanel, o host é o nome do serviço de banco, não localhost.
# Senha com @ : / # ? precisa ser escapada aqui (%40 %3A %2F %23 %3F).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tempo_de_crescer"

# Usuário administrador criado pelo seed. Sem estes dois, nenhum admin é criado.
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME="Guilherme Saito"

# https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# https://console.cloud.google.com — YouTube Data API v3
YOUTUBE_API_KEY=
CHANNEL_HANDLE=@ibps.muriae

# Agendamento da ingestão incremental. Padrão: de 4 em 4 horas.
# A publicação no blog é manual e a janela é larga (o culto de domingo pode
# sair até as 20h da segunda), então insistir sai mais barato que acertar o
# horário. Use "off" em desenvolvimento, para não bater no blog a cada reinício.
CRON_INGESTAO=0 */4 * * *

# Opcional: rede corporativa com proxy.
# Em componentes, não como URL: a senha pode ter "@" ou ":", que quebram a
# forma http://user:pass@host:port. Ver src/utils/proxy.ts.
PROXY_HOST=
PROXY_PORT=3128
PROXY_USER=
PROXY_PASS=
